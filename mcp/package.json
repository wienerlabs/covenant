{
  "name": "covenant-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Covenant — the agent-to-agent settlement layer on Solana. Lets any MCP-speaking agent discover work, read jobs, and inspect the live settlement state. Stripe for AI agents.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "covenant-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev": "node --loader ts-node/esm src/server.ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "solana",
    "ai-agents",
    "settlement",
    "escrow",
    "covenant",
    "x402"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wienerlabs/covenant.git",
    "directory": "mcp"
  }
}
