# === REQUIRED ===
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DEPLOYER_KEYPAIR=[1,2,3,...64 bytes]
ANTHROPIC_API_KEY=sk-ant-api03-...

# === AGENT WALLETS ===
AGENT_ALPHA_KEYPAIR=[1,2,3,...64 bytes]
AGENT_OMEGA_KEYPAIR=[1,2,3,...64 bytes]
AGENT_ALPHA_WALLET=Base58PublicKey
AGENT_OMEGA_WALLET=Base58PublicKey

# === HELIUS (Phase 6) ===
# Enhanced RPC + webhooks. Get a key at https://helius.dev
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Shared secret for verifying Helius webhook POSTs to /api/helius/webhook
HELIUS_WEBHOOK_SECRET=

# === DELIVERY STORAGE (Phase 5) ===
# Vercel Blob token for hosting agent deliverables.
# Get one at Vercel Dashboard -> Storage -> Connect Blob Store
BLOB_READ_WRITE_TOKEN=

# === DISPUTE ARBITRATORS (Phase 7) ===
# Comma-separated base58 pubkeys whitelisted as arbitrators (v1 = 2-of-3 multisig).
# Must match the on-chain ProtocolConfig.arbitrators. Production clients should
# read these from chain instead of env.
COVENANT_ARBITRATORS=
COVENANT_ARBITRATOR_THRESHOLD=2

# === MUTATING-ENDPOINT AUTH (C-091) ===
# Wallet-session auth. Set SESSION_SECRET (>=16 random chars) to ACTIVATE
# enforcement: users sign one login message, get an httpOnly session cookie, and
# every wallet-scoped mutating route then binds the request to the signer. While
# this is unset, mutating endpoints stay open (a prod warning is logged) and the
# UI shows no login prompt. Rotate the secret to revoke all sessions.
SESSION_SECRET=
# Force enforcement on/off regardless of SESSION_SECRET ("true" | "false").
# Leave unset to auto-enforce whenever SESSION_SECRET is configured.
AUTH_ENFORCED=
# Comma-separated API keys for server-to-server / bot callers (x-api-key header).
API_KEYS=

# === CRON JOBS ===
# Shared secret for /api/cron/finalize and /api/cron/reconcile.
# Vercel Cron passes this as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# === IMAGE GENERATION (design category jobs) ===
# fal.ai API key for text-to-image generation. Get one at https://fal.ai/dashboard/keys
# Used by /api/generate/image for design/visual agent deliveries.
FAL_KEY=

# === MAINNET (leave unset for the default devnet deployment) ===
# Full go-live procedure: docs/MAINNET.md. Setting COVENANT_ENV=mainnet makes
# lib/network.ts select mainnet RPC / USDC / explorer and DISABLES the faucet.
# On mainnet the program ID is REQUIRED (no devnet fallback) — the app fails
# loudly if NEXT_PUBLIC_PROGRAM_ID_MAINNET is missing.
COVENANT_ENV=
NEXT_PUBLIC_COVENANT_ENV=
# "onchain" runs real settlement; unset/"simulated" keeps the devnet demo paths.
SETTLEMENT_MODE=
# The program ID from your mainnet deploy (see docs/MAINNET.md).
NEXT_PUBLIC_PROGRAM_ID_MAINNET=
# Mainnet RPC (strongly recommend a Helius/Triton/QuickNode URL, not public).
NEXT_PUBLIC_RPC_URL_MAINNET=
# Optional: override the USDC mint (defaults to canonical mainnet USDC).
NEXT_PUBLIC_USDC_MINT_MAINNET=
# Funded keypair used by the finalize crank on mainnet.
CRANK_KEYPAIR=

# === OPTIONAL ===
# Override the on-chain program ID (devnet default).
COVENANT_PROGRAM_ID=5hstj5grBUL1BeSaPLYpgkD6n3ALasmbseRvKRFfCVNT
# How many recent signatures /api/cron/reconcile scans per run.
RECONCILE_SCAN_LIMIT=500
