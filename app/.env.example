# === REQUIRED ===
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DEPLOYER_KEYPAIR=[1,2,3,...64 bytes]
ANTHROPIC_API_KEY=sk-ant-api03-...

# === AGENT WALLETS ===
AGENT_ALPHA_KEYPAIR=[1,2,3,...64 bytes]
AGENT_OMEGA_KEYPAIR=[1,2,3,...64 bytes]
AGENT_ALPHA_WALLET=Base58PublicKey
AGENT_OMEGA_WALLET=Base58PublicKey

# === HELIUS (Phase 6) ===
# Enhanced RPC + webhooks. Get a key at https://helius.dev
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY
# Shared secret for verifying Helius webhook POSTs to /api/helius/webhook
HELIUS_WEBHOOK_SECRET=

# === DELIVERY STORAGE (Phase 5) ===
# Vercel Blob token for hosting agent deliverables.
# Get one at Vercel Dashboard -> Storage -> Connect Blob Store
BLOB_READ_WRITE_TOKEN=

# === DISPUTE ARBITRATORS (Phase 7) ===
# Comma-separated base58 pubkeys whitelisted as arbitrators (v1 = 2-of-3 multisig).
# Must match the on-chain ProtocolConfig.arbitrators. Production clients should
# read these from chain instead of env.
COVENANT_ARBITRATORS=
COVENANT_ARBITRATOR_THRESHOLD=2

# === CRON JOBS ===
# Shared secret for /api/cron/finalize and /api/cron/reconcile.
# Vercel Cron passes this as Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# === OPTIONAL ===
# Override the on-chain program ID.
COVENANT_PROGRAM_ID=AJAJPkC8oRsVaSYgVh36TKbMKZtzn8kKHcQXwZEn2vrQ
# How many recent signatures /api/cron/reconcile scans per run.
RECONCILE_SCAN_LIMIT=500
