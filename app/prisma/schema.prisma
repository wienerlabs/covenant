generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Core job lifecycle
// ============================================================================

model Job {
  id               String      @id @default(cuid())
  pda              String?     @unique // on-chain JobEscrow PDA (base58)
  escrowAta        String?     // SPL escrow token account (base58); not a PDA in v1
  posterWallet     String
  takerWallet      String?
  amount           Float
  paymentToken     String      @default("USDC") // "USDC" or "SOL"
  specHash         String      // SHA-256 hex of canonical spec JSON
  specJson         Json
  status           String      @default("Open")
  // Open | Accepted | Delivered | Disputed | Finalized | Resolved | Cancelled

  // Challenge period fields (post-pivot)
  challengePeriod  Int         @default(86400) // seconds, default 24h
  challengeEndAt   DateTime?   // set when status becomes Delivered
  deliveredAt      DateTime?

  minWords         Int         @default(0)
  category         String      @default("text_writing")
  language         String      @default("en")
  deadline         DateTime
  txHash           String?     // create_job tx signature
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  delivery         Delivery?
  dispute          Dispute?
  claim            ClaimListing?
  submissions      Submission[]
  events           JobEvent[]
  interests        JobInterest[]

  @@index([posterWallet])
  @@index([takerWallet])
  @@index([status])
  @@index([challengeEndAt])
}

// ============================================================================
// Covenant Credit — BNPL / factoring for pending claims
// ============================================================================
//
// Mirrors the on-chain `ClaimListing` account introduced in PR #36. Every
// row MUST correspond to a real PDA at seeds=[b"claim", job_escrow.key()]
// on the Covenant program. This table is a denormalized view for fast
// marketplace queries — chain is always the source of truth.

model ClaimListing {
  id              String    @id @default(cuid())
  pda             String    @unique         // on-chain ClaimListing PDA (base58)
  jobId           String    @unique         // 1:1 with our Job row
  jobPda          String                    // on-chain JobEscrow PDA (base58)
  sellerWallet   String                     // original taker / seller
  buyerWallet    String?                    // lender after purchase
  price          Float                      // USDC human units the buyer pays
  faceValue      Float                      // USDC human units the buyer receives on finalize
  priceAtomic    String                     // atomic u64 as string (avoid JS precision loss)
  faceValueAtomic String
  status         String    @default("Listed") // Listed | Bought | Cancelled | Settled
  listedAt       DateTime  @default(now())
  boughtAt       DateTime?
  settledAt      DateTime?
  listTxHash     String?                    // list_claim tx signature
  buyTxHash      String?                    // buy_claim tx signature
  cancelTxHash   String?                    // cancel_claim tx signature
  settleTxHash   String?                    // finalize/resolve tx that paid the buyer
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  job            Job       @relation(fields: [jobId], references: [id])

  @@index([sellerWallet])
  @@index([buyerWallet])
  @@index([status])
  @@index([listedAt])
}

// Delivery commitment submitted by the taker via submit_work.
model Delivery {
  id             String   @id @default(cuid())
  jobId          String   @unique
  takerWallet    String
  workHash       String   // SHA-256 hex of the delivered content
  deliveryUri    String   // IPFS / Arweave / HTTPS / Vercel Blob URL
  contentPreview String?  @db.Text // first ~2000 chars for UI; full content at deliveryUri
  imageUrl       String?  // Generated image URL for design/visual tasks
  submittedAt    DateTime @default(now())
  txHash         String?  // submit_work tx signature

  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([takerWallet])
}

// Dispute raised against a delivered job.
model Dispute {
  id             String    @id @default(cuid())
  jobId          String    @unique
  challenger     String    // wallet that raised
  bond           Float     // in payment token units
  reasonHash     String    // SHA-256 hex
  reasonText     String?   @db.Text // off-chain reason body; hash committed on-chain
  raisedAt       DateTime  @default(now())
  txHashRaise    String?
  resolvedAt     DateTime?
  txHashResolve  String?
  resolution     String?   // Pending | FavorTaker | FavorPoster | Split
  takerAmount    Float?    // for Split resolutions
  approvedBy     String[]  @default([]) // arbitrator wallets that voted
  approvalCount  Int       @default(0)

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([challenger])
  @@index([resolution])
}

// Append-only log of on-chain events, keyed by tx signature for
// idempotent webhook consumption.
model JobEvent {
  id          String   @id @default(cuid())
  jobId       String
  type        String   // created | accepted | delivered | disputed | finalized | resolved | cancelled
  txSignature String   @unique
  slot        BigInt?
  blockTime   DateTime?
  wallet      String?  // primary actor for the event
  amount      Float?
  data        Json
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([type])
  @@index([blockTime])
}

// ============================================================================
// Agent identity and reputation
// ============================================================================

model Reputation {
  id             String    @id @default(cuid())
  walletAddress  String    @unique
  jobsCompleted  Int       @default(0)
  jobsFailed     Int       @default(0)
  jobsDisputed   Int       @default(0)
  totalEarned    Float     @default(0)
  avgRating      Float     @default(0)    // 0-5 stars, computed from reviews
  reviewCount    Int       @default(0)
  firstJobAt     DateTime?
  updatedAt      DateTime  @updatedAt
}

model Profile {
  id             String   @id @default(cuid())
  walletAddress  String   @unique
  displayName    String
  bio            String   @default("")
  role           String   @default("both") // poster | taker | both
  avatarSeed     String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PublishedAgent {
  id             String   @id @default(cuid())
  walletAddress  String
  name           String
  description    String
  endpointUrl    String
  agentType      String   @default("Task")
  capabilities   Json
  did            String
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// No-code hosted agents — created via the agent builder UI.
model HostedAgent {
  id            String   @id @default(cuid())
  walletAddress String
  name          String
  category      String   @default("text_writing")
  systemPrompt  String   @db.Text
  model         String   @default("claude-haiku-4-5")
  minPrice      Float    @default(1)
  maxPrice      Float    @default(50)
  avatarSeed    String
  avatarUrl     String?  // uploaded profile image URL
  webEnabled    Boolean  @default(false)
  pricePerPrompt Float   @default(0.05) // USDC per chat message, creator sets this
  totalRevenue  Float    @default(0)    // accumulated revenue from chat usage
  metadataUri   String?  // on-chain metadata JSON URL
  onChainTx     String?  // Solana memo TX signature
  active        Boolean  @default(true)
  jobsCompleted Int      @default(0)
  totalEarned   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([walletAddress])
  @@index([category])
  @@index([active])
}

// ============================================================================
// Legacy / backwards-compat tables
// ============================================================================

// Old per-action submission records. Kept for history; new flows write
// to Delivery instead. Existing UI references still read from here.
model Submission {
  id           String   @id @default(cuid())
  jobId        String
  takerWallet  String
  textHash     String
  wordCount    Int
  verified     Boolean  @default(false)
  txHash       String?
  outputText   String?  @db.Text
  submittedAt  DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id])
}

model Transaction {
  id        String   @id @default(cuid())
  txHash    String   @unique
  type      String   // create_job | accept_job | submit_work | finalize_payment | raise_dispute | resolve_dispute | cancel_job
  jobId     String?
  wallet    String
  amount    Float?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  @@index([wallet])
  @@index([type])
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  wallet    String
  name      String
  calls     Int      @default(0)
  limit     Int      @default(1000)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// Competitive multi-taker
// ============================================================================

/// Tracks every agent that expressed interest in a job. Multiple agents
/// can accept simultaneously; the first to submit_work wins. Others are
/// marked 'withdrawn' when the winner delivers.
model JobInterest {
  id           String   @id @default(cuid())
  jobId        String
  takerWallet  String
  status       String   @default("working") // working | delivered | withdrawn
  acceptedAt   DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, takerWallet])
  @@index([jobId])
  @@index([takerWallet])
}

// ============================================================================
// Gamification: XP, ELO, Achievements, Arena
// ============================================================================

/// Tracks cumulative XP and level per wallet. Level = floor(totalXp / 100).
model UserXP {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  totalXp       Int      @default(0)
  level         Int      @default(1)
  updatedAt     DateTime @updatedAt
}

/// ELO rating for arena agents. Default 1200 (chess standard).
model AgentElo {
  id            String   @id @default(cuid())
  agentWallet   String   @unique
  agentName     String   @default("")
  elo           Int      @default(1200)
  wins          Int      @default(0)
  losses        Int      @default(0)
  draws         Int      @default(0)
  peakElo       Int      @default(1200)
  currentStreak Int      @default(0)  // consecutive wins (reset on loss)
  bestStreak    Int      @default(0)  // all-time best streak
  updatedAt     DateTime @updatedAt
}

/// Category-specific ELO rating.
model AgentCategoryElo {
  id            String   @id @default(cuid())
  agentWallet   String
  category      String
  elo           Int      @default(1200)
  wins          Int      @default(0)
  losses        Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([agentWallet, category])
  @@index([category])
}

/// Spectator chat messages during battles.
model BattleChat {
  id        String   @id @default(cuid())
  sessionId String
  wallet    String?
  message   String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Unlocked achievements per user.
model UserAchievement {
  id              String   @id @default(cuid())
  walletAddress   String
  achievementKey  String   // matches key from ACHIEVEMENTS constant
  unlockedAt      DateTime @default(now())

  @@unique([walletAddress, achievementKey])
  @@index([walletAddress])
}

/// Record of each arena battle for history + ELO calculation.
model ArenaBattle {
  id              String   @id @default(cuid())
  challengeText   String   @db.Text
  category        String   @default("text_writing")
  alphaAgent      String   // wallet or agent id
  omegaAgent      String
  alphaOutput     String?  @db.Text
  omegaOutput     String?  @db.Text
  alphaScore      Float    @default(0)
  omegaScore      Float    @default(0)
  winnerAgent     String?  // null = draw
  judgeReason     String?  @db.Text
  alphaEloBefore  Int?
  omegaEloBefore  Int?
  alphaEloAfter   Int?
  omegaEloAfter   Int?
  createdAt       DateTime @default(now())

  @@index([alphaAgent])
  @@index([omegaAgent])
  @@index([winnerAgent])
}

/// Battle predictions by spectators.
model BattlePrediction {
  id            String   @id @default(cuid())
  battleId      String
  walletAddress String
  prediction    String   // "alpha" | "omega"
  correct       Boolean?
  xpAwarded     Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([battleId, walletAddress])
  @@index([walletAddress])
  @@index([battleId])
}

/// Battle presence / spectator heartbeats.
model BattlePresence {
  id        String   @id @default(cuid())
  sessionId String   @unique
  lastSeen  DateTime @default(now())

  @@index([lastSeen])
}

// ============================================================================
// Growth: Staking, Protocol Fee, Referrals
// ============================================================================

/// Agent USDC stake (skin in the game).
model AgentStake {
  id            String   @id @default(cuid())
  walletAddress String   @unique
  amount        Float    @default(0)
  status        String   @default("active") // active | slashed | returned
  slashedAmount Float    @default(0)
  bonusEarned   Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

/// Protocol fee ledger — tracks fees collected per finalized job.
model ProtocolFee {
  id        String   @id @default(cuid())
  jobId     String   @unique
  amount    Float    // fee amount in USDC
  feeBps    Int      // basis points at time of collection
  paidBy    String   // taker wallet (deducted from their payout)
  createdAt DateTime @default(now())

  @@index([paidBy])
}

/// Chat message history — per user per agent.
model ChatMessage {
  id            String   @id @default(cuid())
  agentId       String
  userWallet    String
  role          String   // "user" | "agent"
  content       String   @db.Text
  createdAt     DateTime @default(now())

  @@index([agentId, userWallet])
  @@index([userWallet])
}

/// Per-message revenue ledger for hosted agents.
model AgentRevenue {
  id            String   @id @default(cuid())
  agentId       String
  userWallet    String
  amount        Float    // USDC charged for this prompt
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([userWallet])
}

/// Referral tracking.
model Referral {
  id             String    @id @default(cuid())
  referrerWallet String
  referredWallet String    @unique
  code           String
  xpAwarded      Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([referrerWallet])
  @@index([code])
}

// ============================================================================
// Reviews (post-finalize rating)
// ============================================================================

/// Poster rates the taker's delivery after finalize/resolve.
/// One review per job. Rating 1-5, optional text comment.
model Review {
  id           String   @id @default(cuid())
  jobId        String   @unique
  posterWallet String
  takerWallet  String
  rating       Int      // 1-5 stars
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  @@index([takerWallet])
  @@index([posterWallet])
}
