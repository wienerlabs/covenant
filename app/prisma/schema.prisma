generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Core job lifecycle
// ============================================================================

model Job {
  id               String      @id @default(cuid())
  pda              String?     @unique // on-chain JobEscrow PDA (base58)
  posterWallet     String
  takerWallet      String?
  amount           Float
  paymentToken     String      @default("USDC") // "USDC" or "SOL"
  specHash         String      // SHA-256 hex of canonical spec JSON
  specJson         Json
  status           String      @default("Open")
  // Open | Accepted | Delivered | Disputed | Finalized | Resolved | Cancelled

  // Challenge period fields (post-pivot)
  challengePeriod  Int         @default(86400) // seconds, default 24h
  challengeEndAt   DateTime?   // set when status becomes Delivered
  deliveredAt      DateTime?

  minWords         Int         @default(0)
  category         String      @default("text_writing")
  language         String      @default("en")
  deadline         DateTime
  txHash           String?     // create_job tx signature
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  delivery         Delivery?
  dispute          Dispute?
  submissions      Submission[]
  events           JobEvent[]
  interests        JobInterest[]

  @@index([posterWallet])
  @@index([takerWallet])
  @@index([status])
  @@index([challengeEndAt])
}

// Delivery commitment submitted by the taker via submit_work.
model Delivery {
  id             String   @id @default(cuid())
  jobId          String   @unique
  takerWallet    String
  workHash       String   // SHA-256 hex of the delivered content
  deliveryUri    String   // IPFS / Arweave / HTTPS / Vercel Blob URL
  contentPreview String?  @db.Text // first ~2000 chars for UI; full content at deliveryUri
  submittedAt    DateTime @default(now())
  txHash         String?  // submit_work tx signature

  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([takerWallet])
}

// Dispute raised against a delivered job.
model Dispute {
  id             String    @id @default(cuid())
  jobId          String    @unique
  challenger     String    // wallet that raised
  bond           Float     // in payment token units
  reasonHash     String    // SHA-256 hex
  reasonText     String?   @db.Text // off-chain reason body; hash committed on-chain
  raisedAt       DateTime  @default(now())
  txHashRaise    String?
  resolvedAt     DateTime?
  txHashResolve  String?
  resolution     String?   // Pending | FavorTaker | FavorPoster | Split
  takerAmount    Float?    // for Split resolutions
  approvedBy     String[]  @default([]) // arbitrator wallets that voted
  approvalCount  Int       @default(0)

  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([challenger])
  @@index([resolution])
}

// Append-only log of on-chain events, keyed by tx signature for
// idempotent webhook consumption.
model JobEvent {
  id          String   @id @default(cuid())
  jobId       String
  type        String   // created | accepted | delivered | disputed | finalized | resolved | cancelled
  txSignature String   @unique
  slot        BigInt?
  blockTime   DateTime?
  wallet      String?  // primary actor for the event
  amount      Float?
  data        Json
  createdAt   DateTime @default(now())

  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([type])
  @@index([blockTime])
}

// ============================================================================
// Agent identity and reputation
// ============================================================================

model Reputation {
  id             String    @id @default(cuid())
  walletAddress  String    @unique
  jobsCompleted  Int       @default(0)
  jobsFailed     Int       @default(0)
  jobsDisputed   Int       @default(0)
  totalEarned    Float     @default(0)
  firstJobAt     DateTime?
  updatedAt      DateTime  @updatedAt
}

model Profile {
  id             String   @id @default(cuid())
  walletAddress  String   @unique
  displayName    String
  bio            String   @default("")
  role           String   @default("both") // poster | taker | both
  avatarSeed     String
  avatarUrl      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PublishedAgent {
  id             String   @id @default(cuid())
  walletAddress  String
  name           String
  description    String
  endpointUrl    String
  agentType      String   @default("Task")
  capabilities   Json
  did            String
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ============================================================================
// Legacy / backwards-compat tables
// ============================================================================

// Old per-action submission records. Kept for history; new flows write
// to Delivery instead. Existing UI references still read from here.
model Submission {
  id           String   @id @default(cuid())
  jobId        String
  takerWallet  String
  textHash     String
  wordCount    Int
  verified     Boolean  @default(false)
  txHash       String?
  outputText   String?  @db.Text
  submittedAt  DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id])
}

model Transaction {
  id        String   @id @default(cuid())
  txHash    String   @unique
  type      String   // create_job | accept_job | submit_work | finalize_payment | raise_dispute | resolve_dispute | cancel_job
  jobId     String?
  wallet    String
  amount    Float?
  status    String   @default("confirmed")
  createdAt DateTime @default(now())

  @@index([wallet])
  @@index([type])
}

model ApiKey {
  id        String   @id @default(cuid())
  key       String   @unique
  wallet    String
  name      String
  calls     Int      @default(0)
  limit     Int      @default(1000)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// Competitive multi-taker
// ============================================================================

/// Tracks every agent that expressed interest in a job. Multiple agents
/// can accept simultaneously; the first to submit_work wins. Others are
/// marked 'withdrawn' when the winner delivers.
model JobInterest {
  id           String   @id @default(cuid())
  jobId        String
  takerWallet  String
  status       String   @default("working") // working | delivered | withdrawn
  acceptedAt   DateTime @default(now())

  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, takerWallet])
  @@index([jobId])
  @@index([takerWallet])
}
