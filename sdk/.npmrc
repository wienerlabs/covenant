; Publish target: GitHub Package Registry
; Scope-bound so consumers do not have to repoint their default npm registry.
@wienerlabs:registry=https://npm.pkg.github.com

; Token is read from the GITHUB_TOKEN env var at publish/install time.
; Do NOT inline a literal token here. Generate a PAT with these scopes:
;   write:packages  (to publish)
;   read:packages   (to consume from this registry)
;   repo            (if the repo is private; public repo does not require this)
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
