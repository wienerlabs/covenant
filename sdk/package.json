{
  "name": "@wienerlabs/covenant-sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the Covenant optimistic settlement protocol on Solana — escrow, dispute, and factoring primitives for AI agent work.",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "idl",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "solana",
    "anchor",
    "ai-agents",
    "escrow",
    "optimistic-settlement",
    "covenant"
  ],
  "dependencies": {
    "@coral-xyz/anchor": "^0.30.1",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^20",
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wienerlabs/covenant.git",
    "directory": "sdk"
  }
}
